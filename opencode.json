{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "planner": {},
    "review": {},
    "code-reviewer": {},
    "researcher": {},
    "debugger": {},
    "test-automator": {},
    "information-scan": {},
    "vulnerability-scan": {},
    "codebase": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "docs": {},
    "documentation-engineer": {},
    "performance-engineer": {},
    "refactoring-specialist": {},
    "blogger": {},
    "brutal-critic": {},
    "em-advisor": {},
    "legal-advisor": {},
    "penetration-tester": {},
    "security-auditor": {},
    "orchestrator": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}