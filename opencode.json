{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-rules@latest",
    "agents-opencode"
  ],
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "agent": {
    "planner": {},
    "review": {},
    "code-reviewer": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "researcher": {},
    "debugger": {},
    "test-automator": {},
    "information-scan": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "vulnerability-scan": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "codebase": {
      "permission": {
        "bash": "allow"
      }
    },
    "docs": {},
    "documentation-engineer": {},
    "performance-engineer": {},
    "refactoring-specialist": {},
    "blogger": {},
    "brutal-critic": {},
    "em-advisor": {},
    "legal-advisor": {},
    "penetration-tester": {},
    "security-auditor": {},
    "orchestrator": {
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    }
  }
}
