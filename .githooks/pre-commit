#!/usr/bin/env bash
# Pre-commit hook: scan for secrets + PII
# Install: git config core.hooksPath .githooks

echo "=== Pre-commit: Lint + Vet + Information Scan ==="
# Run lint on staged files (generic - override per stack)
if [ -f "package.json" ] && command -v npx &> /dev/null; then
  npx --no-install lint-staged 2>/dev/null || true
fi

# Go vet + golangci-lint on staged Go files (installer + harness)
GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.go$' || true)
if [ -n "$GO_FILES" ]; then
  echo "=== Go vet (staged) ==="
  HAS_SRC=$(echo "$GO_FILES" | grep -q '^src/' && echo yes || true)
  HAS_HARNESS=$(echo "$GO_FILES" | grep -q '^tests/harness/' && echo yes || true)
  if [ "$HAS_SRC" = "yes" ]; then
    if ! (cd src && go vet ./...); then
      echo "✗ go vet failed in src/ — commit rejected"
      echo "To bypass: git commit --no-verify"
      exit 1
    fi
  fi
  if [ "$HAS_HARNESS" = "yes" ]; then
    if ! (cd tests/harness && go vet ./...); then
      echo "✗ go vet failed in tests/harness/ — commit rejected"
      exit 1
    fi
  fi
  echo "✓ go vet passed"

  echo "=== golangci-lint (staged) ==="
  if command -v golangci-lint &>/dev/null; then
    LINT_BIN="golangci-lint"
  elif [ -x "$HOME/go/bin/golangci-lint" ]; then
    LINT_BIN="$HOME/go/bin/golangci-lint"
  else
    echo "⚠ golangci-lint not found — skipping (install: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest)"
    LINT_BIN=""
  fi
  if [ -n "$LINT_BIN" ]; then
    if [ "$HAS_SRC" = "yes" ]; then
      if ! (cd src && "$LINT_BIN" run ./...); then
        echo "✗ golangci-lint failed in src/ — commit rejected"
        exit 1
      fi
    fi
    if [ "$HAS_HARNESS" = "yes" ]; then
      if ! (cd tests/harness && "$LINT_BIN" run ./...); then
        echo "✗ golangci-lint failed in tests/harness/ — commit rejected"
        exit 1
      fi
    fi
    echo "✓ golangci-lint passed"
  fi
fi
echo "=== Pre-commit: Information Scan ==="

# Patterns to block
PATTERNS=(
  'AKIA[0-9A-Z]{16}'                          # AWS Access Key
  '-----BEGIN[[:space:]]*(RSA|EC|OPENSSH|DSA)[[:space:]]*PRIVATE KEY-----'  # Private key
  'ghp_[0-9a-zA-Z]{36}'                       # GitHub PAT
  'gho_[0-9a-zA-Z]{36}'                       # GitHub OAuth
  'ghu_[0-9a-zA-Z]{36}'                       # GitHub user token
  'sk-[0-9a-zA-Z]{32,}'                       # OpenAI API key
  'xox[baprs]-[0-9a-zA-Z]{10,}'               # Slack token
  'PGP[[:space:]]+PRIVATE[[:space:]]+KEY'     # PGP key
  $'(password|secret|api_key|apikey)[[:space:]]*[:=][[:space:]]*["\'][^"\']{8,}["\']'  # Generic secret
)

# Files staged for commit
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
BLOCKED=0

for FILE in $FILES; do
  [ -f "$FILE" ] || continue
  for PATTERN in "${PATTERNS[@]}"; do
    # Allow dummy passwords in test fixtures/harness (QEMU fixtures, not real secrets)
    if echo "$PATTERN" | grep -q "password|secret"; then
      case "$FILE" in
        tests/fixtures/*|tests/harness/variables_*.yaml|tests/harness/*.go|docs/*|src/variables/variables.yaml) continue ;;
      esac
    fi
    if git show ":${FILE}" | grep -qiE -- "$PATTERN"; then
      echo "⚠️  BLOCKED: $FILE matches secret pattern"
      BLOCKED=1
    fi
  done
done

if [ $BLOCKED -eq 1 ]; then
  echo "Commit rejected. Remove secrets and try again."
  echo "To bypass (not recommended): git commit --no-verify"
  exit 1
fi

echo "✓ Information scan passed"
exit 0
